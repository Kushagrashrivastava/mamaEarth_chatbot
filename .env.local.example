# Copy this file to .env.local and fill in your keys. .env.local is gitignored.

# Free LLM used by app/api/chat/route.ts to let "Mama" actually answer questions.
# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=

# Human-like voice used by app/api/speech/route.ts (ElevenLabs).
# Free tier: 10,000 characters/month, recurring, no credit card required.
#
# IMPORTANT — confirmed by testing: free-tier accounts get a 402 payment_required
# error ("Free users cannot use library voices via the API") for ANY voice picked
# from the Voice Library, no matter which one. The API only works for free on the
# account's own default/premade voices (Rachel, Adam, Antoni, Bella, Domi, Elli,
# Josh, Arnold, Sam, ...) — none of which are Indian-accented. Get an Indian voice
# here only by upgrading to a paid plan; otherwise pick a default voice's ID from
# https://elevenlabs.io/app/voice-lab ("Adam" = pNInz6obpgDQGcFmaJgB is a safe bet).
#
# 1. Sign up at https://elevenlabs.io and copy your API key from the "Developers"
#    section in the left sidebar (not Settings — that tab doesn't exist there).
# 2. Use a default voice's ID (see above), or upgrade your plan to use one from
#    the Voice Library (https://elevenlabs.io/app/voice-library).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Not currently used (blocked on an Azure subscription — see CHANGELOG.md), kept
# in case that gets unblocked later.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
